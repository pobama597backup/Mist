{
  "upstream_repo": "open-jarvis/OpenJarvis",
  "default_branch": "main",
  "mapping": [
    {"prefix": "src/openjarvis/core/", "module": "oj-spine", "targets": ["src/lib/oj/event-bus.ts", "src/lib/oj/complexity.ts", "src/lib/oj/loop-guard.ts", "src/lib/oj/error-taxonomy.ts", "src/lib/oj/guardrails.ts", "src/lib/services/llm-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/engine/", "module": "oj-spine", "targets": ["src/lib/services/llm-service.ts", "src/lib/oj/trace-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/agents/", "module": "oj-spine", "targets": ["src/lib/oj/trace-service.ts", "src/lib/services/mission-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/intelligence/", "module": "oj-spine", "targets": ["src/lib/oj/complexity.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/sessions/", "module": "oj-mind", "targets": ["src/lib/oj/session-compress.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/memory/", "module": "oj-mind", "targets": ["src/lib/oj/knowledge-service.ts", "src/lib/services/memory-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/learning/", "module": "oj-mind", "targets": ["src/lib/oj/skill-overlay.ts", "src/lib/services/skills-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/traces/", "module": "oj-spine", "targets": ["src/lib/oj/trace-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/evals/", "module": "oj-mind", "targets": ["src/lib/oj/skill-overlay.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/connectors/", "module": "oj-mind", "targets": ["src/lib/oj/connectors.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/skills/", "module": "oj-mind", "targets": ["src/lib/services/skills-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/prompt/", "module": "oj-mind", "targets": ["src/lib/oj/persona.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/operators/", "module": "oj-ops", "targets": ["src/lib/oj/operator-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/workflow/", "module": "oj-ops", "targets": ["src/lib/oj/workflow.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/analytics/", "module": "oj-ops", "targets": ["src/lib/oj/digest-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/scheduler/", "module": "oj-ops", "targets": ["src/lib/services/scheduler-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/daemon/", "module": "oj-ops", "targets": ["src/lib/services/heartbeat-service.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/channels/", "module": "oj-mesh", "targets": ["src/lib/oj/channels.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/mcp/", "module": "oj-mesh", "targets": ["mini-services/mesh-service/index.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/a2a/", "module": "oj-mesh", "targets": ["mini-services/mesh-service/index.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/security/", "module": "oj-mesh", "targets": ["src/lib/oj/rate-limiter.ts", "src/lib/oj/guardrails.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/server/", "module": "oj-mesh", "targets": ["mini-services/mesh-service/index.ts"], "tier": "structural"},
    {"prefix": "src/openjarvis/speech/", "module": "voice", "targets": ["src/app/api/mist/voice/route.ts"], "tier": "structural"},
    {"prefix": "frontend/", "module": "oj-face", "targets": ["src/components/mist/"], "tier": "structural"},
    {"prefix": "desktop/", "module": "excluded", "targets": [], "tier": "excluded", "note": "Tauri desktop — web-only platform, concepts ported in TS"},
    {"prefix": "rust/", "module": "excluded", "targets": [], "tier": "excluded", "note": "Rust perf layer — no equivalent need in TS port"},
    {"prefix": "docs/", "module": "knowledge", "targets": ["knowledge-base"], "tier": "knowledge"},
    {"prefix": "CHANGELOG.md", "module": "knowledge", "targets": ["knowledge-base"], "tier": "knowledge"},
    {"prefix": "README.md", "module": "knowledge", "targets": ["knowledge-base"], "tier": "knowledge"},
    {"prefix": "configs/", "module": "knowledge", "targets": ["knowledge-base"], "tier": "knowledge"},
    {"prefix": "src/openjarvis/mining/", "module": "excluded", "targets": [], "tier": "excluded", "note": "needs H100/Apple Silicon mining hardware"},
    {"prefix": "src/openjarvis/bench/", "module": "excluded", "targets": [], "tier": "excluded", "note": "42-model benchmark suite — model downloads too heavy"}
  ]
