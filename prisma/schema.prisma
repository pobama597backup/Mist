// OpenJarvis integration layer (ported from open-jarvis/OpenJarvis @ 5e5f5ef)
// Reference clone: /home/z/OpenJarvis (do not modify; dissect-only)
// ═══════════════════════════════════════════════════════════════════════

// Trace store — the learning substrate (port of openjarvis/traces/store.py).
// Every chat turn, mission, operator tick, tool loop → typed steps that power
// the Traces viewer, learned routing, skill optimization and personal benchmarks.
model Trace {
  id          String    @id @default(cuid())
  query       String
  agent       String    @default("chat") // chat | mission | operator | subagent | research | voice | digest
  model       String?
  provider    String?
  result      String    @default("")
  outcome     String    @default("running") // running | success | failure | degraded
  feedback    Float? // post-hoc 0..1 score (user thumbs or LLM judge)
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  latencyMs   Int       @default(0)
  costUsd     Float     @default(0)
  complexity  Float     @default(0) // 0..1 complexity score (openjarvis learning/routing/complexity.py)
  tier        String    @default("") // trivial | simple | moderate | complex | very_complex
  tokenBudget Int       @default(0) // tier-derived budget the router assigned
  meta        String    @default("{}") // JSON: conversationId, missionId, operator, finishReason…
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  createdAt   DateTime  @default(now())

  steps TraceStep[]

  @@index([agent, createdAt])
  @@index([outcome, createdAt])
}

model TraceStep {
  id         String   @id @default(cuid())
  traceId    String
  trace      Trace    @relation(fields: [traceId], references: [id], onDelete: Cascade)
  idx        Int
  type       String // route | retrieve | generate | tool_call | respond
  name       String   @default("") // tool name / model name
  input      String   @default("{}")
  output     String   @default("{}")
  ok         Boolean  @default(true)
  durationMs Int      @default(0)
  tokens     Int      @default(0)
  meta       String   @default("{}") // skill tags, finish reason, provider attempts…
  createdAt  DateTime @default(now())

  @@index([traceId, idx])
}

// Knowledge store (port of openjarvis/connectors KnowledgeStore) — ingested
// personal knowledge chunks searched by hybrid BM25+vector with RRF fusion.
model KnowledgeChunk {
  id          String   @id @default(cuid())
  source      String // upload | obsidian | notes | github | research | web
  sourceId    String   @default("") // file path / url / repo
  docType     String   @default("document") // document | note | research | web | vault
  title       String   @default("")
  chunkIdx    Int      @default(0)
  content     String
  meta        String   @default("{}") // author, url, ingestedAt, threadId, contentHash…
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
}

// Tiered approval queue (port of openjarvis proactive approval suite +
// the ApprovalBell pattern) — agent-proposed actions awaiting the creator.
model Approval {
  id          String    @id @default(cuid())
  actionType  String // tool_exec | file_write | spend | skill_install | operator_enable
  fingerprint String // "{action_type}:{key}" — matches PermissionMemory
  title       String
  payload     String    @default("{}")
  tier        String    @default("medium") // trivial | low | medium | high
  status      String    @default("pending") // pending | approved | denied | expired
  origin      String    @default("mist") // mist | operator | mission | subagent
  decidedBy   String?
  createdAt   DateTime  @default(now())
  decidedAt   DateTime?

  @@index([status, createdAt])
}

// Remembered consent (port of openjarvis approval_store.py) — "always yes for
// X" / "never for Y" per action fingerprint, so she never asks twice.
model PermissionMemory {
  id          String   @id @default(cuid())
  fingerprint String   @unique
  decision    String // always_approve | always_deny
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Operators — persistent scheduled agents driven by manifests (port of
// openjarvis/operators: researcher, news_digest, system_monitor, …).
model Operator {
  id         String    @id @default(cuid())
  slug       String    @unique
  name       String
  manifest   String    @default("{}") // JSON: {systemPrompt, tools[], schedule{type,value}, metrics[]}
  status     String    @default("active") // active | paused
  stateKey   String    @default("") // longterm-memory key "operator:{slug}:state"
  lastRunAt  DateTime?
  lastStatus String?
  runCount   Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([status])
}

// Digest history (port of openjarvis morning digest) — sectioned briefings
// generated from her own sources, with optional TTS audio artifact.
model Digest {
  id        String   @id @default(cuid())
  kind      String   @default("daily") // daily | on_demand
  sections  String   @default("{}") // JSON: {sectionKey: {title, content, sources[]}}
  content   String   @default("") // full markdown
  audioPath String? // path under db/digest/ when spoken
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// w3 speed — instant replies: normalized prompt → her chosen reply text.
// Canned smalltalk lives in code (fast-path.ts); this table caches what the
// cascade actually answered for a repeated simple prompt so the SECOND ask
// is milliseconds (Mark-LV measured-ladder philosophy: never pay twice).
model FastReply {
  id        String   @id @default(cuid())
  cacheKey  String   @unique // sha256(normalized prompt)
  prompt    String // the raw prompt that seeded it (human-readable audit)
  text      String // her reply — replayed verbatim on cache hit
  kind      String   @default("cached") // smalltalk | status | cached
  hits      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// w3 speed — spoken audio cache: sha256(engine|voice|speed|text) → wav bytes.
// Turns a cache-hit reply into instant VOICE, not just instant text.
model SpokenCache {
  id        String   @id @default(cuid())
  hash      String   @unique
  bytes     Bytes // wav audio
  size      Int
  createdAt DateTime @default(now())
}

// w3 notify — the teacher's Mark-LV updates, translated by Clare into a
// message for the creator: what changed, her honest opinion, and the
// question "would this be useful?" — answered with wanted / dismissed.
model TeacherNotice {
  id        String   @id @default(cuid())
  head      String // mark-lv head sha the update landed on
  commits   Int
  digest    String   @default("{}") // JSON: [{sha, subject, files[]}]
  message   String // Clare's words to the creator (what changed + the ask)
  opinion   String   @default("") // her honest take on usefulness for M.I.S.T.
  status    String   @default("new") // new | wanted | dismissed
  seenAt    DateTime?
  createdAt DateTime @default(now())

  @@index([status, createdAt])
}
